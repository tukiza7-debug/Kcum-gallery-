<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog susunan: kunci susun + arah -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sort_by"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <RadioGroup
        android:id="@+id/rg_sort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rb_sort_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/sort_date" />

        <RadioButton
            android:id="@+id/rb_sort_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_name" />

        <RadioButton
            android:id="@+id/rb_sort_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_size" />

        <RadioButton
            android:id="@+id/rb_sort_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_type" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sort_order"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <RadioGroup
        android:id="@+id/rg_order"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rb_sort_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/sort_desc" />

        <RadioButton
            android:id="@+id/rb_sort_asc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_asc" />
    </RadioGroup>
</LinearLayout>
