<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog cipta folder: nama + pilihan lokasi (MediaStore lalai / SAF custom) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/folder_name_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <EditText
        android:id="@+id/et_folder_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/folder_name_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/location_title"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <RadioGroup
        android:id="@+id/rg_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rb_location_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/location_default" />

        <RadioButton
            android:id="@+id/rb_location_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/location_custom" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.7"
        android:text="@string/custom_loc_warning"
        android:textAppearance="?attr/textAppearanceBodySmall" />
</LinearLayout>
