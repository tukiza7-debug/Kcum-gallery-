<?xml version="1.0" encoding="utf-8"?>
<!--
  Peraturan data extraction (API 31+).
  Sama seperti backup_rules: album peribadi + tong sampah TIDAK disandarkan.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="hidden" />
        <exclude domain="file" path="trash" />
        <exclude domain="sharedpref" path="kcum_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="hidden" />
        <exclude domain="file" path="trash" />
        <exclude domain="sharedpref" path="kcum_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
